# Optional settings for docker compose. Copy to .env and change what you need;
# without a .env file the defaults below are used.

# Host port of the web app: http://localhost:3000
WEB_PORT=3000

# API log level: debug, info, warn or error.
LOG_LEVEL=info

# Requests per second and burst size allowed per client IP.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Address range of the internal network. Change it only if it clashes with a
# network on your machine; the API trusts X-Forwarded-For from this range only.
NETWORK_SUBNET=172.28.0.0/24
